@model AgregarVM
@using System.Globalization
@functions {
    // Visual: $5.500 (formato argentino)
    static string Money(decimal d) => "$" + d.ToString("N0", new CultureInfo("es-AR"));
    // Para data-precio y el hidden: siempre con punto decimal (el servidor corre en cultura invariante)
    static string Inv(decimal d) => d.ToString("0.##", CultureInfo.InvariantCulture);
}
@{
    ViewData["Title"] = "Realizar pedido · Pizzería Torren";

    // Pizza preseleccionada: ?variedad= del "+" del landing, o la que ya estaba si el POST falló
    var buscada = Model.VariedadPrevia ?? Model.Form.PizzaVariedad;
    var elegida = Model.Pizzas.FirstOrDefault(p => string.Equals(p.Variedad, buscada, StringComparison.OrdinalIgnoreCase))
                  ?? Model.Pizzas.FirstOrDefault();
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/pizza-cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Pedido-Agregar.css" asp-append-version="true" />
}

<div class="header-invernal mb-4">
    <div class="container text-center">
        <h1 class="display-6 mb-1"><i class="bi bi-snow me-2"></i> Realizá tu pedido</h1>
        <p class="mb-0 opacity-75">Seleccioná tu pizza, indicá la cantidad y confirmá los datos de entrega.</p>
    </div>
</div>

<div class="container mb-5">
    <form asp-controller="Pedido" asp-action="Agregar" method="post" id="formPedido">
        @* El token antiforgery lo agrega solo el form tag helper *@

        @* Los name llevan el prefijo "Form." para bindear con AgregarVM.Form (PedidoDTO) *@
        <input type="hidden" id="PizzaVariedad" name="Form.PizzaVariedad" value="@elegida?.Variedad" />
        <input type="hidden" id="PizzaPrecio" name="Form.PizzaPrecio" value="@(elegida is null ? "0" : Inv(elegida.Precio))" />

        <div class="row g-4">

            <!-- Catálogo: las pizzas salen de la tabla Pizzas -->
            <div class="col-lg-8">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-secondary-emphasis">
                        <i class="bi bi-grid-3x3-gap-fill text-muted me-2"></i>1. Seleccioná tu variedad
                    </h5>
                    <span class="text-muted small">Hacé clic sobre una tarjeta</span>
                </div>

                @if (!Model.Pizzas.Any())
                {
                    <div class="alert alert-warning">Todavía no hay pizzas cargadas en la carta.</div>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-2 g-3" role="radiogroup" aria-label="Variedad de pizza">
                        @foreach (var p in Model.Pizzas)
                        {
                            var activa = elegida is not null && p.Id == elegida.Id;
                            <div class="col">
                                <div class="pizza-card @(activa ? "seleccionada" : "")"
                                     role="radio" tabindex="0" aria-checked="@(activa ? "true" : "false")"
                                     data-variedad="@p.Variedad" data-precio="@Inv(p.Precio)">
                                    <span class="badge-seleccion"><i class="bi bi-check-circle-fill me-1"></i>Seleccionada</span>
                                    <div class="pizza-img-container">
                                        @if (!string.IsNullOrWhiteSpace(p.ImagenUrl))
                                        {
                                            <img src="@p.ImagenUrl" alt="@p.Variedad" class="pizza-img" loading="lazy" onerror="this.remove()">
                                        }
                                        else
                                        {
                                            <i class="bi bi-image" aria-hidden="true"></i>
                                        }
                                        <span class="badge-precio">@Money(p.Precio)</span>
                                    </div>
                                    <div class="p-3 d-flex flex-column flex-grow-1">
                                        <h5 class="fw-bold mb-1">@p.Variedad</h5>
                                        <p class="small text-muted mb-0">@p.Descripcion</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Resumen y datos del cliente -->
            <div class="col-lg-4">
                <div class="resumen-card">
                    <div class="resumen-header">
                        <i class="bi bi-receipt me-2"></i>2. Resumen y entrega
                    </div>

                    <div class="p-3">
                        <div class="card bg-light border-0 p-3 mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-semibold" id="resumenPizzaNombre">@elegida?.Variedad</span>
                                <span class="badge bg-secondary" id="resumenPrecioUnitario">@(elegida is null ? "" : Money(elegida.Precio) + " c/u")</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <label class="small fw-semibold text-muted" for="Cantidad">Cantidad:</label>
                                <div class="qty-box">
                                    <button type="button" class="btn-qty" id="btnRestar" aria-label="Restar"><i class="bi bi-dash"></i></button>
                                    <input asp-for="Form.Cantidad" id="Cantidad" type="number" class="qty-input" min="1" max="50" required />
                                    <button type="button" class="btn-qty" id="btnSumar" aria-label="Sumar"><i class="bi bi-plus"></i></button>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3 px-1">
                            <span class="fw-bold text-secondary">Total:</span>
                            <span class="h4 mb-0 fw-bold text-dark" id="totalTexto">@(elegida is null ? "$0" : Money(elegida.Precio * Math.Max(1, Model.Form.Cantidad)))</span>
                        </div>

                        <hr class="text-secondary opacity-25 my-3">

                        <h6 class="fw-bold mb-3 text-secondary-emphasis">
                            <i class="bi bi-person-lines-fill me-1"></i>3. Datos del cliente
                        </h6>

                        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label for="ClienteNombre" class="form-label small fw-semibold">Nombre del cliente</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light text-secondary"><i class="bi bi-person"></i></span>
                                <input asp-for="Form.ClienteNombre" id="ClienteNombre" class="form-control" placeholder="Ej: Rubén Torren" maxlength="150" autocomplete="name" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="ClienteDireccion" class="form-label small fw-semibold">Dirección de entrega</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light text-secondary"><i class="bi bi-geo-alt"></i></span>
                                <input asp-for="Form.ClienteDireccion" id="ClienteDireccion" class="form-control" placeholder="Ej: Av. San Martín 1234" maxlength="255" autocomplete="street-address" required />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-invernal w-100 shadow-sm mt-2" id="btnEnviar" disabled="@(elegida is null)">
                            <i class="bi bi-check2-circle me-1"></i> Confirmar pedido
                        </button>

                        <a asp-controller="Home" asp-action="Index" class="btn-volver-catalogo mt-2">
                            <i class="bi bi-arrow-left me-1"></i> Volver al menú principal
                        </a>

                        <div class="text-center mt-3">
                            <small class="text-muted"><i class="bi bi-stopwatch me-1"></i> Tiempo de cocina: ~35 min</small>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </form>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.pizza-card');
    const inputVariedad = document.getElementById('PizzaVariedad');
    const inputPrecio = document.getElementById('PizzaPrecio');
    const inputCantidad = document.getElementById('Cantidad');
    const resumenNombre = document.getElementById('resumenPizzaNombre');
    const resumenPrecioUnitario = document.getElementById('resumenPrecioUnitario');
    const totalTexto = document.getElementById('totalTexto');

    const money = n => '$' + Number(n).toLocaleString('es-AR');
    // Selección inicial = la card marcada por el servidor (viene de la DB / ?variedad=)
    const inicial = document.querySelector('.pizza-card.seleccionada');
    let seleccion = inicial
        ? { variedad: inicial.dataset.variedad, precio: parseFloat(inicial.dataset.precio) }
        : { variedad: '', precio: 0 };

    function actualizarTotales() {
        const cantidad = Math.min(50, Math.max(1, parseInt(inputCantidad.value) || 1));
        inputCantidad.value = cantidad;

        inputVariedad.value = seleccion.variedad;
        inputPrecio.value = String(seleccion.precio);   // punto decimal: el servidor usa cultura invariante

        resumenNombre.textContent = seleccion.variedad;
        resumenPrecioUnitario.textContent = money(seleccion.precio) + ' c/u';
        totalTexto.textContent = money(seleccion.precio * cantidad);
    }

    function elegir(card) {
        cards.forEach(c => { c.classList.remove('seleccionada'); c.setAttribute('aria-checked', 'false'); });
        card.classList.add('seleccionada');
        card.setAttribute('aria-checked', 'true');
        seleccion = { variedad: card.dataset.variedad, precio: parseFloat(card.dataset.precio) };
        actualizarTotales();
    }

    cards.forEach(card => {
        card.addEventListener('click', () => elegir(card));
        card.addEventListener('keydown', e => {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); elegir(card); }
        });
    });

    document.getElementById('btnSumar').addEventListener('click', () => {
        inputCantidad.value = (parseInt(inputCantidad.value) || 1) + 1;
        actualizarTotales();
    });
    document.getElementById('btnRestar').addEventListener('click', () => {
        inputCantidad.value = (parseInt(inputCantidad.value) || 1) - 1;
        actualizarTotales();
    });
    inputCantidad.addEventListener('change', actualizarTotales);

    if (inicial) actualizarTotales();
});
</script>
}
