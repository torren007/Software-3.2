@model Torren3.API.PedidoDTO
@{
    ViewData["Title"] = "Pedido Confirmado";
}

<div class="container mt-5 text-center">
    <!-- Usamos @Model para incrustar datos dinámicos en el HTML[cite: 5] -->
    <h1 class="text-success">¡Gracias, @Model.NombreCliente!</h1>
    
    <div class="alert alert-info mt-4">
        <h4>Tu pedido ha sido recibido con éxito.</h4>
        <p>Enviaremos <strong>@Model.Cantidad</strong> pizza(s) a la dirección: <strong>@Model.Direccion</strong>.</p>
        <p>Nos comunicaremos al <em>@Model.Telefono</em> si necesitamos confirmar algún detalle.</p>
    </div>

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Volver al Inicio</a>
</div>