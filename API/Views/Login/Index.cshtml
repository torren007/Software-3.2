@model LoginViewModel
@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.Hosting
@inject IWebHostEnvironment Env
@{
    ViewData["Title"] = "Iniciar sesión · Pizzería Torren";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Login-Index.css" asp-append-version="true" />
}

<main class="login-page">
    <div class="login-card">
        <div class="login-head">
            <h1>Iniciar sesión</h1>
            <p>Para hacer un pedido necesitás estar logueado.</p>
        </div>

        <form class="login-form" asp-controller="Login" asp-action="Index" method="post" novalidate>
            @* Para volver a donde ibas (ej: /Pedido/Agregar?variedad=Calabresa) *@
            <input type="hidden" asp-for="ReturnUrl" />

            @if (!string.IsNullOrEmpty(Model.ReturnUrl) && ViewData.ModelState.IsValid)
            {
                <div class="info-msg" role="status">Iniciá sesión para continuar con tu pedido.</div>
            }

            <div asp-validation-summary="ModelOnly" class="err-msg" role="alert"></div>

            <div>
                <label class="lb" asp-for="Email">Email</label>
                <input asp-for="Email" autocomplete="username" placeholder="vos@ejemplo.com" autofocus />
                <span class="field-err" asp-validation-for="Email"></span>
            </div>

            <div>
                <label class="lb" asp-for="Password">Contraseña</label>
                <input asp-for="Password" autocomplete="current-password" />
                <span class="field-err" asp-validation-for="Password"></span>
            </div>

            <label class="check">
                <input asp-for="Persistente" />
                <span>Mantenerme logeado</span>
            </label>

            <button class="btn-login" type="submit">Entrar</button>

            @if (Env.IsDevelopment())
            {
                <p class="dev-hint">Solo en desarrollo: admin@pizzeria.com / admin1234</p>
            }

            <p class="login-foot">
                ¿No tenés cuenta?
                <a asp-controller="Registro" asp-action="Index" asp-route-returnUrl="@Model.ReturnUrl">Creá una</a>
            </p>
            <p class="login-foot"><a asp-controller="Home" asp-action="Index">← Volver a la carta</a></p>
        </form>
    </div>
</main>
