@model IEnumerable<Torren3.Models.Pizza>
@{
    ViewData["Title"] = "Pizzería";
}

<div class="text-center mt-5">
    <h1 class="display-4">🍕 Sistema de Gestión de Pizzería</h1>
    <p class="lead">Plataforma distribuida con persistencia relacional MySQL y sincronización TCP Sockets.</p>
    <hr class="my-4">
    <div class="d-flex justify-content-center gap-3">
        <a class="btn btn-danger btn-lg px-4" href="/Pedido/Agregar">Pedir Pizza (Formulario HTML)</a>
        <a class="btn btn-outline-dark btn-lg px-4" href="/pedidos" target="_blank">Ver Pedidos (API JSON)</a>
    </div>
</div>

<!-- Sección Hero (Banner Principal) -->
<section class="hero text-center py-5 bg-dark text-white">
    <div class="container">
        <h1 class="display-4">Bienvenido a Pizzería Torren</h1>
        <p class="lead">Las mejores pizzas artesanales, listas para disfrutar.</p>
        <!-- Tag Helper para redirigir al formulario de pedidos -->
        <a asp-controller="Pedido" asp-action="Crear" class="btn btn-primary btn-lg mt-3">¡Pedir Ahora!</a>
    </div>
</section>

<hr class="my-5">

<!-- Sección de Productos Dinámicos -->
<section class="productos container">
    <h2 class="text-center mb-4">Nuestras Especialidades</h2>
    
    <div class="row">
        @* Iteramos sobre el modelo dinámico enviado por el controlador *@
        @foreach (var pizza in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <img src="@pizza.ImagenUrl" class="card-img-top" alt="Foto de @pizza.Nombre">
                    <div class="card-body">
                        <h3 class="card-title h5">@pizza.Nombre</h3>
                        <p class="card-text text-muted">@pizza.Descripcion</p>
                        <p class="card-text fw-bold fs-5">$@pizza.Precio.ToString("N2")</p>
                    </div>
                    <div class="card-footer bg-transparent border-0">
                        <a asp-controller="Pedido" asp-action="Agregar" asp-route-id="@pizza.Id" class="btn btn-outline-success w-100">Agregar al Carrito</a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>