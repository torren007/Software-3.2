@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Pedido Confirmado";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap 5.3 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- Vinculación del CSS de Confirmación -->
    <link rel="stylesheet" href="~/css/Pedido-Confirmacion.css" />
</head>

<body>

    <div class="confirmacion-card">
        <div class="confirmacion-header">
            <div class="icono-check">
                <i class="bi bi-check2"></i>
            </div>
            <h3 class="fw-bold mb-1">¡Pedido Recibido!</h3>
            <p class="mb-0 text-white-50">Tu orden ya está en la cocina</p>
        </div>

        <div class="p-4 text-center">
            <div class="alert alert-light border text-start mb-4" style="border-color: #c5d4e2 !important;">
                <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-geo-alt-fill text-muted me-2"></i>
                    <span class="small text-muted">Destino:</span>
                    <strong class="ms-auto small">@(ViewBag.Direccion ?? "A domicilio")</strong>
                </div>
                <div class="d-flex align-items-center">
                    <i class="bi bi-hourglass-split text-muted me-2"></i>
                    <span class="small text-muted">Demora aproximada:</span>
                    <strong class="ms-auto small">35 minutos</strong>
                </div>
            </div>

            <p class="text-muted small mb-4">
                Recibirás un mensaje de confirmación en breve. Te avisaremos cuando el repartidor vaya en camino.
            </p>

            <div class="d-grid gap-2">
                <!-- Acción 1: Pedir otra pizza (TagHelper puro) -->
                <a asp-controller="Pedido" asp-action="Agregar" class="btn-pedido-nuevo shadow-sm">
                    🍕 Pedir otra pizza ahora
                </a>

                <!-- Acción 2: Volver al menú principal (TagHelper puro) -->
                <a asp-controller="Home" asp-action="Index" class="btn-volver-menu">
                    <i class="bi bi-arrow-left me-1"></i> Volver al Menú Principal
                </a>
            </div>
        </div>
    </div>

</body>
</html>