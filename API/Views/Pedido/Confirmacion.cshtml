@{
    ViewData["Title"] = "Pedido Confirmado";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap 5.3 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    
    <style>
        body {
            background-color: #f1f5f9;
            color: #1e293b;
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }

        .confirmacion-card {
            background: #ffffff;
            border: 1px solid #c5d4e2;
            border-radius: 16px;
            max-width: 520px;
            width: 100%;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(36, 52, 71, 0.08);
        }

        .confirmacion-header {
            background: linear-gradient(135deg, #243447 0%, #3b536b 100%);
            color: #ffffff;
            padding: 2.5rem 1.5rem;
            text-align: center;
        }

        .icono-check {
            width: 65px;
            height: 65px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 1rem;
        }

        .btn-volver {
            background-color: #3b536b;
            color: #ffffff;
            border-radius: 8px;
            padding: 0.65rem 1.5rem;
            text-decoration: none;
            display: inline-block;
            transition: background-color 0.2s;
        }

        .btn-volver:hover {
            background-color: #243447;
            color: #ffffff;
        }
    </style>
</head>
<body>

    <div class="confirmacion-card">
        <div class="confirmacion-header">
            <div class="icono-check">
                <i class="bi bi-check2"></i>
            </div>
            <h3 class="fw-bold mb-1">¡Pedido Recibido!</h3>
            <p class="mb-0 text-white-50">Tu orden ya está en la cocina</p>
        </div>

        <div class="p-4 text-center">
            <div class="alert alert-light border text-start mb-4" style="border-color: #c5d4e2 !important;">
                <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-geo-alt-fill text-muted me-2"></i>
                    <span class="small text-muted">Destino:</span>
                    <strong class="ms-auto small">@(ViewBag.Direccion ?? "A domicilio")</strong>
                </div>
                <div class="d-flex align-items-center">
                    <i class="bi bi-hourglass-split text-muted me-2"></i>
                    <span class="small text-muted">Demora aproximada:</span>
                    <strong class="ms-auto small">35 minutos</strong>
                </div>
            </div>

            <p class="text-muted small mb-4">
                Recibirás un mensaje de confirmación en breve. Te avisaremos cuando el repartidor vaya en camino.
            </p>

            <a asp-controller="Home" asp-action="Index" class="btn-volver w-100">
                <i class="bi bi-arrow-left me-1"></i> Volver al Inicio
            </a>
        </div>
    </div>

</body>
</html>