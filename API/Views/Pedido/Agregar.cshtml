@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Realizar Pedido de Pizza";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pizzería</title>

    <!-- Bootstrap 5.3 CSS & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --invierno-oscuro: #203142;
            --invierno-primario: #3a506b;
            --invierno-acento: #5b7a9c;
            --invierno-borde: #cbd5e1;
            --invierno-fondo: #edf2f7;
            --invierno-superficie: #ffffff;
            --invierno-texto: #1e293b;
            --invierno-activo-bg: #e2eaf2;
        }

        body {
            background-color: var(--invierno-fondo);
            color: var(--invierno-texto);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
        }

        .header-invernal {
            background: linear-gradient(135deg, var(--invierno-oscuro) 0%, var(--invierno-primario) 100%);
            color: #ffffff;
            padding: 2.2rem 1rem;
            border-bottom: 3px solid var(--invierno-borde);
            box-shadow: 0 4px 16px rgba(32, 49, 66, 0.08);
        }

        .pizza-card {
            background: var(--invierno-superficie);
            border: 2px solid var(--invierno-borde);
            border-radius: 14px;
            overflow: hidden;
            transition: all 0.2s ease-in-out;
            cursor: pointer;
            height: 100%;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .pizza-card:hover {
            transform: translateY(-3px);
            border-color: var(--invierno-acento);
            box-shadow: 0 8px 20px rgba(58, 80, 107, 0.12);
        }

        .pizza-card.seleccionada {
            border-color: var(--invierno-primario);
            background-color: var(--invierno-activo-bg);
            box-shadow: 0 0 0 3px rgba(58, 80, 107, 0.25);
        }

        .pizza-card.seleccionada .badge-seleccion {
            display: block !important;
        }

        .badge-seleccion {
            display: none;
            position: absolute;
            top: 12px;
            left: 12px;
            background-color: var(--invierno-primario);
            color: #ffffff;
            font-weight: 600;
            font-size: 0.8rem;
            padding: 0.35rem 0.75rem;
            border-radius: 20px;
            z-index: 2;
        }

        .pizza-img-container {
            height: 165px;
            overflow: hidden;
            position: relative;
            background-color: #cbd5e1;
        }

        .pizza-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .pizza-card:hover .pizza-img {
            transform: scale(1.04);
        }

        .badge-precio {
            position: absolute;
            top: 12px;
            right: 12px;
            background-color: rgba(32, 49, 66, 0.85);
            color: #ffffff;
            backdrop-filter: blur(4px);
            font-weight: 600;
            font-size: 0.9rem;
            padding: 0.35rem 0.75rem;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            z-index: 2;
        }

        .resumen-card {
            background: var(--invierno-superficie);
            border: 1px solid var(--invierno-borde);
            border-radius: 14px;
            box-shadow: 0 6px 18px rgba(32, 49, 66, 0.06);
            position: sticky;
            top: 1.5rem;
        }

        .resumen-header {
            background-color: #f8fafc;
            border-bottom: 1px solid var(--invierno-borde);
            padding: 1rem 1.25rem;
            border-radius: 14px 14px 0 0;
            color: var(--invierno-oscuro);
            font-weight: 600;
        }

        .form-control {
            border: 1px solid var(--invierno-borde);
            border-radius: 8px;
            padding: 0.6rem 0.85rem;
            color: var(--invierno-texto);
        }

        .form-control:focus {
            border-color: var(--invierno-acento);
            box-shadow: 0 0 0 0.2rem rgba(91, 122, 156, 0.2);
        }

        .qty-box {
            display: flex;
            align-items: center;
            border: 1px solid var(--invierno-borde);
            border-radius: 8px;
            background-color: #ffffff;
            overflow: hidden;
        }

        .btn-qty {
            background: #f1f5f9;
            border: none;
            color: var(--invierno-primario);
            font-size: 1.2rem;
            width: 40px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.15s;
        }

        .btn-qty:hover {
            background-color: #e2eaf1;
            color: var(--invierno-oscuro);
        }

        .qty-input {
            width: 50px;
            text-align: center;
            border: none;
            font-weight: 700;
            font-size: 1.05rem;
            color: var(--invierno-oscuro);
        }

        .btn-invernal {
            background-color: var(--invierno-primario);
            color: #ffffff;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            padding: 0.8rem 1.5rem;
            transition: background-color 0.2s, transform 0.1s;
        }

        .btn-invernal:hover {
            background-color: var(--invierno-oscuro);
            color: #ffffff;
            transform: translateY(-1px);
        }

        .btn-volver-catalogo {
            border: 1px solid var(--invierno-borde);
            color: #64748b;
            background: transparent;
            font-weight: 500;
            border-radius: 8px;
            padding: 0.6rem 1.2rem;
            text-decoration: none;
            display: block;
            text-align: center;
            transition: all 0.15s ease;
        }

        .btn-volver-catalogo:hover {
            background-color: #f1f5f9;
            color: var(--invierno-oscuro);
        }
    </style>
</head>
<body>

    <header class="header-invernal mb-4">
        <div class="container text-center">
            <h1 class="display-6 mb-1"><i class="bi bi-snow me-2"></i> Pizzería Artesanal</h1>
            <p class="mb-0 opacity-75">Selecciona tu pizza, indica la cantidad y confirma los datos del pedido.</p>
        </div>
    </header>

    <div class="container mb-5">
        <!-- Sin el atributo 'action', permitiendo que los Tag Helpers lo generen correctamente -->
        <form asp-controller="Pedido" asp-action="Agregar" method="post" id="formPedido">
            
            @Html.AntiForgeryToken()

            <input type="hidden" id="PizzaVariedad" name="PizzaVariedad" value="Muzzarella" />
            <input type="hidden" id="PizzaPrecio" name="PizzaPrecio" value="5500" />
            <input type="hidden" id="Nombre" name="Nombre" value="" />
            <input type="hidden" id="Direccion" name="Direccion" value="" />

            <div class="row g-4">
                
                <!-- Catálogo de Variedades -->
                <div class="col-lg-8">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0 text-secondary-emphasis">
                            <i class="bi bi-grid-3x3-gap-fill text-muted me-2"></i>1. Selecciona tu variedad
                        </h5>
                        <span class="text-muted small">Haz clic sobre una tarjeta</span>
                    </div>

                    <div class="row row-cols-1 row-cols-md-2 g-3">
                        <!-- Muzzarella -->
                        <div class="col">
                            <div class="pizza-card seleccionada" data-variedad="Muzzarella" data-precio="5500">
                                <span class="badge-seleccion"><i class="bi bi-check-circle-fill me-1"></i>Seleccionada</span>
                                <div class="pizza-img-container">
                                    <img src="https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=600&q=80" alt="Muzzarella" class="pizza-img" loading="lazy">
                                    <span class="badge-precio">$5.500</span>
                                </div>
                                <div class="p-3 d-flex flex-column flex-grow-1">
                                    <h5 class="fw-bold mb-1">Muzzarella</h5>
                                    <p class="small text-muted mb-0">Salsa de tomate casera, queso muzzarella fundido, orégano y aceitunas negras.</p>
                                </div>
                            </div>
                        </div>

                        <!-- Napolitana -->
                        <div class="col">
                            <div class="pizza-card" data-variedad="Napolitana" data-precio="6200">
                                <span class="badge-seleccion"><i class="bi bi-check-circle-fill me-1"></i>Seleccionada</span>
                                <div class="pizza-img-container">
                                    <img src="https://images.unsplash.com/photo-1574071318508-1cdbab80d002?auto=format&fit=crop&w=600&q=80" alt="Napolitana" class="pizza-img" loading="lazy">
                                    <span class="badge-precio">$6.200</span>
                                </div>
                                <div class="p-3 d-flex flex-column flex-grow-1">
                                    <h5 class="fw-bold mb-1">Napolitana</h5>
                                    <p class="small text-muted mb-0">Muzzarella, rodajas de tomate natural seleccionados, toque de ajo fresco y albahaca.</p>
                                </div>
                            </div>
                        </div>

                        <!-- Fugazzeta -->
                        <div class="col">
                            <div class="pizza-card" data-variedad="Fugazzeta" data-precio="6400">
                                <span class="badge-seleccion"><i class="bi bi-check-circle-fill me-1"></i>Seleccionada</span>
                                <div class="pizza-img-container">
                                    <img src="https://images.unsplash.com/photo-1593560708920-61dd98c46a4e?auto=format&fit=crop&w=600&q=80" alt="Fugazzeta" class="pizza-img" loading="lazy">
                                    <span class="badge-precio">$6.400</span>
                                </div>
                                <div class="p-3 d-flex flex-column flex-grow-1">
                                    <h5 class="fw-bold mb-1">Fugazzeta</h5>
                                    <p class="small text-muted mb-0">Cebolla dorada al orégano, doble capa de muzzarella y pimienta blanca.</p>
                                </div>
                            </div>
                        </div>

                        <!-- Calabresa -->
                        <div class="col">
                            <div class="pizza-card" data-variedad="Calabresa" data-precio="6800">
                                <span class="badge-seleccion"><i class="bi bi-check-circle-fill me-1"></i>Seleccionada</span>
                                <div class="pizza-img-container">
                                    <img src="https://images.unsplash.com/photo-1628840042765-356cda07504e?auto=format&fit=crop&w=600&q=80" alt="Calabresa" class="pizza-img" loading="lazy">
                                    <span class="badge-precio">$6.800</span>
                                </div>
                                <div class="p-3 d-flex flex-column flex-grow-1">
                                    <h5 class="fw-bold mb-1">Calabresa</h5>
                                    <p class="small text-muted mb-0">Longaniza calabresa artesanal, toque de ají molido y base de queso suave.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Panel Lateral de Resumen -->
                <div class="col-lg-4">
                    <div class="resumen-card">
                        
                        <div class="resumen-header">
                            <i class="bi bi-receipt me-2"></i>2. Resumen y Entrega
                        </div>

                        <div class="p-3">
                            <div class="card bg-light border-0 p-3 mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-semibold" id="resumenPizzaNombre">Muzzarella</span>
                                    <span class="badge bg-secondary" id="resumenPrecioUnitario">$5.500 c/u</span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <label class="small fw-semibold text-muted">Cantidad:</label>
                                    <div class="qty-box">
                                        <button type="button" class="btn-qty" id="btnRestar" aria-label="Restar"><i class="bi bi-dash"></i></button>
                                        <input type="number" id="Cantidad" name="Cantidad" class="qty-input" value="1" min="1" max="20" required>
                                        <button type="button" class="btn-qty" id="btnSumar" aria-label="Sumar"><i class="bi bi-plus"></i></button>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-3 px-1">
                                <span class="fw-bold text-secondary">Total:</span>
                                <span class="h4 mb-0 fw-bold text-dark" id="totalTexto">$5.500</span>
                            </div>

                            <hr class="text-secondary opacity-25 my-3">

                            <h6 class="fw-bold mb-3 text-secondary-emphasis">
                                <i class="bi bi-person-lines-fill me-1"></i>3. Datos del Cliente
                            </h6>

                            <div class="mb-3">
                                <label for="ClienteNombre" class="form-label small fw-semibold">Nombre del Cliente</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light text-secondary"><i class="bi bi-person"></i></span>
                                    <input type="text" class="form-control" id="ClienteNombre" name="ClienteNombre" placeholder="Ej: Rubén Torren" required>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="ClienteDireccion" class="form-label small fw-semibold">Dirección de Entrega</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light text-secondary"><i class="bi bi-geo-alt"></i></span>
                                    <input type="text" class="form-control" id="ClienteDireccion" name="ClienteDireccion" placeholder="Ej: Av. San Martín 1234" required>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-invernal w-100 shadow-sm mt-2" id="btnEnviar">
                                <i class="bi bi-check2-circle me-1"></i> Confirmar Pedido
                            </button>

                            <!-- Sin el atributo 'href' para evitar colisión con asp-controller/asp-action -->
                            <a asp-controller="Home" asp-action="Index" class="btn-volver-catalogo mt-2">
                                <i class="bi bi-arrow-left me-1"></i> Volver al Menú Principal
                            </a>

                            <div class="text-center mt-3">
                                <small class="text-muted"><i class="bi bi-stopwatch me-1"></i> Tiempo de cocina: ~35 min</small>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </form>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const cards = document.querySelectorAll('.pizza-card');
            const inputVariedad = document.getElementById('PizzaVariedad');
            const inputPrecio = document.getElementById('PizzaPrecio');
            const inputCantidad = document.getElementById('Cantidad');
            const btnSumar = document.getElementById('btnSumar');
            const btnRestar = document.getElementById('btnRestar');

            const resumenNombre = document.getElementById('resumenPizzaNombre');
            const resumenPrecioUnitario = document.getElementById('resumenPrecioUnitario');
            const totalTexto = document.getElementById('totalTexto');

            const inputClienteNombre = document.getElementById('ClienteNombre');
            const inputClienteDireccion = document.getElementById('ClienteDireccion');
            const hiddenNombre = document.getElementById('Nombre');
            const hiddenDireccion = document.getElementById('Direccion');

            let seleccion = {
                variedad: 'Muzzarella',
                precio: 5500
            };

            function actualizarTotales() {
                const cantidad = Math.max(1, parseInt(inputCantidad.value) || 1);
                inputCantidad.value = cantidad;

                inputVariedad.value = seleccion.variedad;
                inputPrecio.value = seleccion.precio;

                resumenNombre.textContent = seleccion.variedad;
                resumenPrecioUnitario.textContent = '$' + seleccion.precio.toLocaleString('es-AR') + ' c/u';

                const total = seleccion.precio * cantidad;
                totalTexto.textContent = '$' + total.toLocaleString('es-AR');
            }

            cards.forEach(card => {
                card.addEventListener('click', () => {
                    cards.forEach(c => c.classList.remove('seleccionada'));
                    card.classList.add('seleccionada');

                    seleccion.variedad = card.getAttribute('data-variedad');
                    seleccion.precio = parseFloat(card.getAttribute('data-precio'));

                    actualizarTotales();
                });
            });

            btnSumar.addEventListener('click', () => {
                inputCantidad.value = parseInt(inputCantidad.value || 1) + 1;
                actualizarTotales();
            });

            btnRestar.addEventListener('click', () => {
                const actual = parseInt(inputCantidad.value || 1);
                if (actual > 1) {
                    inputCantidad.value = actual - 1;
                    actualizarTotales();
                }
            });

            inputCantidad.addEventListener('change', actualizarTotales);

            document.getElementById('formPedido').addEventListener('submit', () => {
                hiddenNombre.value = inputClienteNombre.value.trim();
                hiddenDireccion.value = inputClienteDireccion.value.trim();
            });

            actualizarTotales();
        });
    </script>
</body>
</html>